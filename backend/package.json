{
  "name": "05.01-express-simple-api",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "app.js",
  "scripts": {
    "prebuild": "node -e \"const {rmSync}=require('fs'); for (const p of ['dist','tsconfig.tsbuildinfo']) rmSync(p, { recursive: true, force: true })\"",
    "build": "tsc -p ./tsconfig.json",
    "postbuild": "node scripts/verify-dist.mjs",
    "start": "node dist/app.js",
    "bootstrap": "node dist/scripts/bootstrap.js",
    "start:dev": "tsc-watch --noClear -p ./tsconfig.json --onSuccess \"node ./dist/app.js\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mikro-orm/core": "6.4.16",
    "@mikro-orm/mysql": "6.4.16",
    "@mikro-orm/sql-highlighter": "1.0.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.1",
    "express": "4.18.2",
    "express-rate-limit": "^8.3.2",
    "groq-sdk": "^0.37.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "reflect-metadata": "0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "4.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "20.5.0",
    "@types/node-cron": "^3.0.11",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "tsc-watch": "^6.0.4",
    "typescript": "^5.1.6",
    "vitest": "^4.0.18"
  }
}
