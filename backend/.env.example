JWT_SECRET="COPY PASTE DATA"
REFRESH_SECRET="COPY PASTE DATA"
CHANGE_SECRET="COPY PASTE DATA"
BREVO_KEY="COPY PASTE DATA"
MAIL="COPY PASTE DATA"
BASE_URL="http://localhost:5173"
GROQ_API_KEY="COPY PASTE DATA"

# Dónde vive MySQL. En local, la base propia; desplegado, la que da la plataforma.
DATABASE_URL="mysql://usuario:contraseña@localhost:3306/gardenOfficedb"

# "production" cambia tres cosas: apaga Swagger, endurece el limitador de intentos y
# hace que la cookie del refresh viaje cross-site (secure + sameSite none).
NODE_ENV="development"

# El puerto lo asigna la plataforma al desplegar. En local se deja sin poner: usa 3000.
# PORT=3000

# Desde qué direcciones se acepta al navegador, separadas por coma. Es la dirección
# pública del front. localhost ya está permitido siempre.
WEB_ORIGIN="https://ignaciolurati1.github.io"

# Solo en desarrollo: si está, todos los mails van a esta casilla en vez de a la persona,
# con el destinatario real al principio del asunto. La base de prueba tiene direcciones de
# verdad, y probar algo que manda mails no puede terminar escribiéndoles. En producción se
# ignora aunque esté puesta.
# MAIL_DEV_TO="tu-casilla@ejemplo.com"


# ============================================================
#  Una instalación por consultorio
# ============================================================
# El mismo código corre en más de un consultorio, cada uno con su base, su dominio y sus
# claves. Lo de abajo es lo que distingue una instalación de otra, y en producción el
# servidor no arranca sin estos valores (ver config/envCheck). Ninguna clave se comparte
# entre instalaciones: dos deploys con la misma clave de firma significan que una sesión de
# uno entra en el otro.

# Nombre corto de esta instalación. Va adentro de cada token como quién lo emitió, y
# etiqueta los mails en el proveedor para que la lectura de rebotes mire solo los propios.
# No es el dominio: el dominio puede cambiar sin que cambie la instalación.
TOKEN_ISSUER="jardin"

# Exigir que cada token diga de dónde salió y para qué puerta sirve.
# Se prende un mes después de desplegar esto por primera vez. Antes de eso hay sesiones
# vivas firmadas sin esos campos —el refresh dura treinta días— y prenderlo saca a todo el
# mundo. Apagado, un token viejo entra y uno con los campos equivocados no.
TOKEN_STRICT="0"

# Cómo firma esta instalación sus mails en la bandeja de entrada.
MAIL_SENDER_NAME="Consultorios del Jardín"

# Los administradores con los que arranca la base, formato correo|Nombre|Apellido,
# separados por coma. Va una sola cuenta: la que abre la consola la primera vez. Los
# administradores del consultorio se crean después desde la consola, no acá.
INITIAL_ADMINS="tu-casilla@ejemplo.com|Nombre|Apellido"


# ============================================================
#  Consola de instalaciones
# ============================================================
# La única página que puede crear un administrador. Vive en su propio dominio, tiene su
# propia clave de firma y su propia lista de cuentas. Ver console/console.guard.

# Clave de firma de la consola. Tiene que ser distinta de JWT_SECRET: con el mismo valor,
# una sesión del consultorio abre la consola. El arranque lo comprueba y se niega.
CONSOLE_JWT_SECRET="COPY PASTE DATA"

# El dominio de la consola, y nada más. Para estas rutas el origen es obligatorio: a
# diferencia del resto de la aplicación, una request sin Origin se rechaza.
CONSOLE_ORIGIN="https://tu-consola.ejemplo.com"

# Las cuentas que pueden usar la consola, separadas por coma. Son las mías, no las del
# cliente. Sin la lista cargada no entra nadie.
OWNER_EMAILS="tu-casilla@ejemplo.com"


# Casilla que recibe el formulario de contacto y las postulaciones. Si no está, usa MAIL.
# CONTACT_MAIL="contacto@ejemplo.com"
