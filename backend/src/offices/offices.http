###Find all offices
GET http://localhost:3000/api/offices


### Obtain an office by ID
@idOffice = ({office.response.body.data.id})

GET http://localhost:3000/api/offices/{{idOffice}}

### Create a new office
# @name CreateOffice
POST http://localhost:3000/api/offices
Content-Type: application/json

{
    "idOffice": 2,
    "closingTime": "18:00",
    "openingTime": "08:00",
    "description": "Rojo",
    "city": "02"
}

### Create a new office with invalid time
POST http://localhost:3000/api/offices
Content-Type: application/json

{
    "idOffice": 2,
    "city": "02",
    "description": "Rojo",
    "closingTime": "8:00",
    "openingTime": "18:00"
}

### Modify an office
PUT http://localhost:3000/api/offices/{{idOffice}}
Content-Type: application/json

{
  "description": "Azul"
}

### Modify an office with invalid time
PUT http://localhost:3000/api/offices/01
Content-Type: application/json

{
  "closingTime": "8:00",
  "openingTime": "18:00",
  "description": "Azul"
}

### Modify an office (PATCH)
PATCH http://localhost:3000/api/offices/01
Content-Type: application/json

{
  "description": "Verde"
}

### Delete an office
DELETE http://localhost:3000/api/offices/01