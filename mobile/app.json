{
  "expo": {
    "name": "Consultorios del Jardín",
    "slug": "consultorios-del-jardin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "consultoriosjardin",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f1f4f6",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.consultoriosdeljardin.app"
    },
    "android": {
      "package": "com.consultoriosdeljardin.app",
      "adaptiveIcon": {
        "backgroundColor": "#12211a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f1f4f6",
          "dark": {
            "backgroundColor": "#0b1210"
          },
          "image": "./assets/images/leaf-mark.png",
          "imageWidth": 238
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "283b7fa1-4f0a-446e-92a7-b9b823f12f50"
      }
    }
  }
}
