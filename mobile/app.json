{
  "expo": {
    "name": "Consultorios del Jardín",
    "slug": "consultorios-del-jardin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "consultoriosjardin",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f1f4f6",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.consultoriosdeljardin.app"
    },
    "android": {
      "package": "com.consultoriosdeljardin.app",
      "adaptiveIcon": {
        "backgroundColor": "#12211a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12211a",
          "dark": { "backgroundColor": "#12211a" },
          "image": "./assets/images/leaf.png",
          "imageWidth": 96
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
