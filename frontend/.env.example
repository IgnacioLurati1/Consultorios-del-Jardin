# Dónde está el backend.
#
# En desarrollo se deja sin poner: el proxy de Vite manda /api a localhost:3000.
# Desplegado no hay proxy, así que hace falta la dirección completa, terminada en /api.
# En GitHub Actions no se lee de acá sino de la variable VITE_API_URL del repo.
# VITE_API_URL="https://tu-backend.up.railway.app/api"

# Prefijo del sitio. Lo pone el workflow al publicar en Pages, que sirve todo colgado del
# nombre del repo. En desarrollo va sin poner.
# VITE_BASE="/Consultorios-del-Jardin/"
